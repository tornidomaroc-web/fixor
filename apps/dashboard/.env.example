# ============================================================================
# Fixor dashboard environment variables
# Copy to `.env.local` for local dev. Vercel env vars must mirror this list.
# ============================================================================

# -- Clerk auth (Phase 5C-2) -------------------------------------------------
# Create an application at https://clerk.com.
# Enable GitHub OAuth as the only sign-in method (disable email/password,
# magic link, etc. in the Clerk dashboard's "User & Authentication" tab).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# Default redirects post-auth. The catch-all sign-in route below handles
# any sub-path Clerk uses for OAuth callbacks.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/
# Where users land after signing out via the <UserButton/>:
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# -- Fixor GitHub App (Phase 5C-2) -------------------------------------------
# Used to filter the user's installations down to ones that have Fixor
# installed. Both come from the GitHub App settings page (the same App
# the backend uses for webhook auth).
#   FIXOR_GITHUB_APP_ID:   numeric id (matches the backend's GITHUB_APP_ID)
#   FIXOR_GITHUB_APP_SLUG: kebab-case name in the install URL,
#                          e.g. github.com/apps/<slug>/installations/new
FIXOR_GITHUB_APP_ID=123456
FIXOR_GITHUB_APP_SLUG=fixor
