# ============================================================================
# Fixor dashboard environment variables
# Copy to `.env.local` for local dev. Vercel env vars must mirror this list.
# ============================================================================

# -- Clerk auth (Phase 5C-2) -------------------------------------------------
# Create an application at https://clerk.com.
# Enable GitHub OAuth as the only sign-in method (disable email/password,
# magic link, etc. in the Clerk dashboard's "User & Authentication" tab).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# Default redirects post-auth. The catch-all sign-in route below handles
# any sub-path Clerk uses for OAuth callbacks.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/
# Where users land after signing out via the <UserButton/>:
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# -- Fixor GitHub App (Phase 5C-2) -------------------------------------------
# Used to filter the user's installations down to ones that have Fixor
# installed. Both come from the GitHub App settings page (the same App
# the backend uses for webhook auth).
#   FIXOR_GITHUB_APP_ID:   numeric id (matches the backend's GITHUB_APP_ID)
#   FIXOR_GITHUB_APP_SLUG: kebab-case name in the install URL,
#                          e.g. github.com/apps/<slug>/installations/new
FIXOR_GITHUB_APP_ID=123456
FIXOR_GITHUB_APP_SLUG=fixor

# -- Postgres (Phase 5C-3) ---------------------------------------------------
# Same Neon connection string the backend uses. The dashboard reads
# orgs + cost_ledger to render the home page; from 5C-5 it also writes
# org_settings + audit_log via the PATCH route.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# -- Paddle Billing (Phase 5D) -----------------------------------------------
# Paddle is the merchant of record (see roadmap Decision Log
# 2026-04-27). 5D-1 only adds the placeholders — checkout overlay and
# webhook handling land in 5D-2 / 5D-3. The dashboard needs the price
# ids to render the upgrade buttons; it does NOT need the API key
# (server-only) or webhook secret (Railway-side).
# PADDLE_PRICE_INDIE=pri_replace-with-indie-id
# PADDLE_PRICE_PRO=pri_replace-with-pro-id
# PADDLE_PRICE_TEAM=pri_replace-with-team-id
# Public client token used by Paddle.js to open the checkout overlay.
# Safe to expose to the browser — it scopes the SDK to your account.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace-with-client-token
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox  # sandbox | production

# -- Resend transactional email (Phase 5D-3 onward) --------------------------
# Used by the Paddle webhook handler to email cancellation /
# payment-failed notices. While unset, sendBillingEmail logs a stub
# line in the Vercel function logs and skips delivery; the webhook
# still 200s so Paddle does NOT retry. 5D-6 adds the welcome /
# suspended / monthly-digest templates that share these same vars.
# RESEND_API_KEY=re_replace-with-server-side-key
# RESEND_FROM_EMAIL=Fixor <billing@your-verified-domain.com>
