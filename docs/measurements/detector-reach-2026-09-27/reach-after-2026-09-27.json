    "model": "claude-sonnet-4-6",
    "fixorTree": "the commit carrying this file (branch feat/detector-reach-heldout on c3646bd); the intermediate figures were taken from the working tree between the pattern edit and the skip-list edit"
  },
  "rate": {
    "usdPerCall": 0.03548,
    "provenance": "Arm A measured observer cost $0.9579 over 27 calls (arm-a-result-2026-09-19.json); mean, real files; a projection when applied to other files"
  },
  "whatChanged": {
    "routeDeclarationRegex": "EXPRESS_ROUTE_DEF_RE (shared by auth-bypass and admin-check): chained method call at line start (same-line path or open paren), server/fastify identifiers with a / path, the route verb, Hapi server.route({ / [",
    "idorSources": [
      "destructured_request_id",
      "fastify_request_params",
      "searchparams_get_id"
    ],
    "idorSinks": [
      "drizzle_where_eq",
      "drizzle_db_builder",
      "knex_table",
      "knex_where_id",
      "mongoose_write_by_id",
      "typeorm_find_by",
      "sequelize_destroy",
      "prisma_upsert_delete_many",
      "kysely_table_op",
      "supabase_from_table",
      "orm_raw_escape_hatch"
    ],
    "idorSinksDeferred": {
      "patterns": [
        ".update(",
        ".delete(",
        ".updateMany(",
        ".save("
      ],
      "why": "present in 7 of the 26 frozen idor replay fixtures (.update( in positive 01, 04, 05, 08 and negative 07; .delete( in negative 06; .updateMany( in negative 08; .save( in positive 02, 06 and negative 02, 05), so adding them moves those request keys and the replay gate fails; re-recording is a paid owner decision (last full idor re-record measured $0.28092, record-idor-fixtures.ts header)",
      "reachNotMeasured": "the counterfactual reach of the deferred set was NOT measured; Arm A case 04 (filesService.update(fileId, ...)) is the one known case it would touch"
    },
    "skipPathRule": "the five model-reaching detectors adopted secrets-exposure's 2026-09-12 copy byte for byte (adds e2e, e2e-*, api_tests/api-tests, app-tests segments, script/ singular, and *.test.*, *.spec.*, _test.go names); all six copies are identical again",
    "proximityThreshold": "unchanged at 200; the only Arm A case it would have admitted (10, pair 322 lines apart) has its defect about 1250 lines from that pair, so a wider window would report reach without the model seeing the defect",
    "systemPrompts": "untouched; every SYSTEM_PROMPT_FINGERPRINT is as on main; all five replay gates green with the recorded keys"
  },
  "intermediate_patternsOnly_oldSkipList": {
    "note": "the working tree after the pattern change and BEFORE the skip-list change; kept because it is the evidence for the skip-list change",
