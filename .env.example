# ============================================================================
# Fixor environment variables
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ============================================================================

# -- Server -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# DRY_RUN=true         # when true, Fixor analyzes but does not post PR comments
# LOG_LEVEL=info       # trace | debug | info | warn | error

# -- Anthropic (required) -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -- GitHub App auth (preferred) ---------------------------------------------
# Create a GitHub App, install it on a repo/org, then fill these.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...replace-with-your-key...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-long-random-hex

# -- GitHub PAT auth (fallback, dev only) ------------------------------------
# Used when GITHUB_APP_* are not set. Needs repo + pull_request scopes.
# GITHUB_TOKEN=ghp_...

# -- Cloudinary (PDF report hosting) -----------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -- Persistence (pilot only; Postgres coming in V2) -------------------------
# FIXOR_PILOT_STORE_PATH=./data/fixor-pilot-store.json
