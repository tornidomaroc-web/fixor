# ============================================================================
# Fixor environment variables
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ============================================================================

# -- Server -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# DRY_RUN=true         # when true, Fixor analyzes but does not post PR comments
# LOG_LEVEL=info       # trace | debug | info | warn | error

# -- Anthropic (required) -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -- GitHub App auth (preferred) ---------------------------------------------
# Create a GitHub App, install it on a repo/org, then fill these.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...replace-with-your-key...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-long-random-hex
# ALLOW_UNSIGNED_WEBHOOKS=true  # dev-only escape hatch when secret is absent; refused in production

# -- GitHub PAT auth (fallback, dev only) ------------------------------------
# Used when GITHUB_APP_* are not set. Needs repo + pull_request scopes.
# GITHUB_TOKEN=ghp_...

# -- Cloudinary (PDF + SARIF report hosting) ---------------------------------
# From Phase 5A-7 onward, uploads use type=authenticated and PR comment
# links are signed URLs with a TTL (default 1 hour). Override the TTL
# with FIXOR_REPORT_URL_TTL_SECONDS (in seconds; min 60).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# FIXOR_REPORT_URL_TTL_SECONDS=3600

# -- Persistence (pilot only; Postgres coming in V2) -------------------------
# FIXOR_PILOT_STORE_PATH=./data/fixor-pilot-store.json

# -- Database (Neon Postgres — Phase 5A-2 onward) ----------------------------
# Create a project at https://neon.tech, copy the pooled connection string.
# Required from Phase 5A-3 (Drizzle). Until then this is informational only.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# -- Sentry (Phase 5A-6) -----------------------------------------------------
# Create a project at https://sentry.io, copy the DSN. Optional locally
# (Sentry no-ops without DSN); required on Railway so prod errors are
# captured + searchable. SENTRY_TRACES_SAMPLE_RATE controls performance
# monitoring (0.0–1.0; default 0.1 = 10% of webhooks traced).
# SENTRY_DSN=https://<key>@<orgid>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.1

# -- Paddle Billing (Phase 5D) -----------------------------------------------
# Paddle is Fixor's merchant of record (see roadmap Decision Log
# 2026-04-27 — Stripe is unavailable in the operator's country, and
# Paddle handles VAT/sales tax + chargebacks). 5D-1 only adds the
# placeholders; checkout + webhook handling are wired in 5D-2 / 5D-3.
#
# Create the products + recurring prices in the Paddle dashboard, then
# paste their `pri_*` ids here. The free tier has no Paddle product.
# PADDLE_API_KEY=apikey_replace-with-server-side-key
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace-with-webhook-secret
# PADDLE_PRICE_INDIE=pri_replace-with-indie-id
# PADDLE_PRICE_PRO=pri_replace-with-pro-id
# PADDLE_PRICE_TEAM=pri_replace-with-team-id
#
# -- Resend transactional email (Phase 5E-4 onward, backend) -----------------
# Phase 5E-4 added a backend-side first-scan email. The webhook
# handler calls maybeSendFirstScanEmail after the PR comment posts;
# that path uses these env vars. While unset, the helper logs a stub
# line and returns ok — no scan ever fails over a missing email.
# RESEND_API_KEY=re_replace-with-server-side-key
# RESEND_FROM_EMAIL=Fixor <hello@your-verified-domain.com>
#
# Note: the dashboard runtime (Vercel) has its own RESEND_API_KEY for
# the Paddle billing emails — see apps/dashboard/.env.example. Both
# can point at the same Resend project; the API key + from-address
# don't need to differ.

# -- Dashboard URL base (Phase 5E-5) -----------------------------------------
# Used by backend-side emails that link back into the dashboard
# (e.g. the 80%-of-budget nudge → /orgs/<id>/billing). Set it to
# the production Vercel URL — when unset, the helper falls back to
# https://app.fixor.dev which is a placeholder.
# FIXOR_DASHBOARD_URL=https://your-dashboard.vercel.app

# -- Cost cap (Phase 4C) -----------------------------------------------------
# Hard caps per GitHub installation. Defaults: $5/month, $2/day.
# FIXOR_MONTHLY_CAP_USD=5
# FIXOR_DAILY_CAP_USD=2
# Comma-separated installation ids that bypass caps (your own org for testing):
# FIXOR_BUDGET_EXEMPT_INSTALLATIONS=12345,67890
# Optional override for ledger location (default ./data/fixor-cost-ledger.json):
# FIXOR_COST_LEDGER_PATH=/data/fixor-cost-ledger.json
